  "components": {
    "schemas": {
      "AnalysisResponse": {
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "metrics": {
            "$ref": "#/components/schemas/MetricsTable"
          },
          "series": {
            "additionalProperties": {
              "additionalProperties": {
                "items": {
                  "$ref": "#/components/schemas/SeriesPoint"
                },
                "type": "array"
              },
              "type": "object"
            },
            "type": "object",
            "title": "Series"
          },
          "tables": {
            "$ref": "#/components/schemas/Tables"
          }
        },
        "type": "object",
        "required": [
          "meta",
          "metrics",
          "series",
          "tables"
        ],
        "title": "AnalysisResponse"
      },
      "AnalyzeRequest": {
        "properties": {
          "dates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Dates",
            "description": "Shared date axis (ISO 8601 strings)."
          },
          "returns": {
            "additionalProperties": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "object",
            "minProperties": 1,
            "title": "Returns",
            "description": "Strategy name -> per-date returns (decimal, not %)."
          },
          "benchmark": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Benchmark",
            "description": "Optional benchmark returns aligned to `dates`."
          },
          "benchmark_name": {
            "type": "string",
            "title": "Benchmark Name",
            "description": "Label for the benchmark column.",
            "default": "Benchmark"
          },
          "rf": {
            "type": "number",
            "title": "Rf",
            "description": "Risk-free rate (annual, decimal).",
            "default": 0.0
          },
          "compounded": {
            "type": "boolean",
            "title": "Compounded",
            "description": "Compound returns (vs simple sum).",
            "default": true
          },
          "periods_per_year": {
            "type": "integer",
            "title": "Periods Per Year",
            "description": "Annualization factor.",
            "default": 252
          },
          "rolling_window": {
            "type": "integer",
            "minimum": 2.0,
            "title": "Rolling Window",
            "description": "Rolling-metric window length.",
            "default": 126
          }
        },
        "type": "object",
        "required": [
          "dates",
          "returns"
        ],
        "title": "AnalyzeRequest",
        "description": "One or more return series on a shared date axis, plus optional benchmark.\n\nA single key in ``returns`` is a single-strategy analysis; multiple keys is a\nmulti-strategy comparison."
      },
      "CompareRequest": {
        "properties": {
          "dates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Dates",
            "description": "Shared date axis (ISO 8601)."
          },
          "strategies": {
            "additionalProperties": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "object",
            "minProperties": 2,
            "title": "Strategies",
            "description": "Strategy name -> per-date returns (2+ strategies)."
          },
          "rf": {
            "type": "number",
            "title": "Rf",
            "default": 0.0
          },
          "compounded": {
            "type": "boolean",
            "title": "Compounded",
            "default": true
          },
          "periods_per_year": {
            "type": "integer",
            "title": "Periods Per Year",
            "default": 252
          },
          "rolling_window": {
            "type": "integer",
            "minimum": 2.0,
            "title": "Rolling Window",
            "default": 126
          }
        },
        "type": "object",
        "required": [
          "dates",
          "strategies"
        ],
        "title": "CompareRequest",
        "description": "Compare several custom strategies on a shared date axis."
      },
      "CompareSymbolsRequest": {
        "properties": {
          "symbols": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 2,
            "title": "Symbols",
            "description": "Tickers to compare."
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "default": "yfinance"
          },
          "period": {
            "type": "string",
            "title": "Period",
            "default": "5y"
          },
          "rf": {
            "type": "number",
            "title": "Rf",
            "default": 0.0
          },
          "compounded": {
            "type": "boolean",
            "title": "Compounded",
            "default": true
          },
          "periods_per_year": {
            "type": "integer",
            "title": "Periods Per Year",
            "default": 252
          },
          "rolling_window": {
            "type": "integer",
            "minimum": 2.0,
            "title": "Rolling Window",
            "default": 126
          }
        },
        "type": "object",
        "required": [
          "symbols"
        ],
        "title": "CompareSymbolsRequest",
        "description": "Compare several tickers fetched server-side (e.g. ['AAPL', 'NVDA'])."
      },
      "ComparisonResponse": {
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
